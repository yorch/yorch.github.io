---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projectsRaw from "../data/projects.json";
import curation from "../data/curation.json";

const hiddenSet = new Set((curation.hidden ?? []) as string[]);
const visibleRaw = Array.isArray((curation as any).visible) && (curation as any).visible.length > 0
  ? projectsRaw.filter((p) => ((curation as any).visible as string[]).includes(p.name))
  : projectsRaw.filter((p) => !hiddenSet.has(p.name));
const overrides = (curation.overrides ?? {}) as Record<string, { description?: string; homepage?: string | null }>;
const visible = visibleRaw.map((p) => {
  const o = overrides[p.name];
  return o ? { ...p, description: o.description ?? p.description, homepage: o.homepage ?? p.homepage } : p;
});
const featuredNames = (curation.featured ?? []) as string[];
const featured = featuredNames.map((n) => visible.find((p) => p.name === n)).filter(Boolean) as typeof visible;
const rest = visible.filter((p) => !new Set(featured.map((f) => f.name)).has(p.name)).sort((a, b) => b.stars - a.stars || new Date(b.updated).getTime() - new Date(a.updated).getTime());
const sorted = [...featured, ...rest];
const languages = [...new Set(visible.map((p) => p.language).filter(Boolean))].sort() as string[];
const totalStars = visible.reduce((s, p) => s + p.stars, 0);
const totalAll = projectsRaw.length;
const hiddenCount = totalAll - visible.length;
---

<Base title="yorch@web — Jorge Barnaby" description="Principal Software Engineer — terminal portfolio, open source showcase, 31 curated projects.">
  <!-- NAV — terminal prompt style -->
  <header class="sticky top-0 z-30 border-b border-zinc-800/70 bg-[#0a0a0b]/80 backdrop-blur">
    <div class="mx-auto flex h-[56px] max-w-[1120px] items-center justify-between px-6">
      <a href="/" class="flex items-center gap-3 font-mono text-sm">
        <span class="text-emerald-400">yorch@web:~$</span>
        <span class="hidden text-zinc-500 md:inline">— Jorge Barnaby</span>
        <span class="ml-2 hidden rounded bg-zinc-900 px-2 py-0.5 text-xs text-zinc-400 md:inline">31 shown</span>
      </a>
      <nav class="flex items-center gap-3 font-mono text-xs">
        <a href="#projects" class="hidden text-zinc-400 hover:text-white md:inline">ls projects/</a>
        <button id="open-palette-nav" class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-zinc-300 hover:border-zinc-700 hover:text-white">
          <span class="text-zinc-500">$</span> ⌘K
        </button>
        <a href="https://github.com/yorch" target="_blank" class="inline-flex items-center gap-2 rounded-full bg-emerald-500 px-3 py-1.5 font-medium text-black hover:bg-emerald-400">GitHub →</a>
      </nav>
    </div>
  </header>

  <!-- TERMINAL HERO — neofetch + stats -->
  <section class="mx-auto max-w-[1120px] px-6 py-6">
    <div class="rounded-xl border border-emerald-900/30 bg-black p-4 font-mono text-[12.5px] leading-5 shadow-xl md:p-6">
      <div class="flex items-center gap-2 border-b border-zinc-800 pb-3 text-xs">
        <span class="h-3 w-3 rounded-full bg-red-500"></span><span class="h-3 w-3 rounded-full bg-yellow-500"></span><span class="h-3 w-3 rounded-full bg-green-500"></span>
        <span class="ml-2 text-zinc-500">yorch@web:~/open-source — zsh — {visible.length} curated</span>
        <span class="ml-auto hidden items-center gap-2 text-zinc-600 md:flex"><span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span> {totalStars} ★ · {languages.length} langs</span>
      </div>
      <div class="mt-4 grid gap-6 md:grid-cols-[1.25fr_0.75fr]">
        <div>
          <div class="text-emerald-400">yorch@web:~/open-source$ neofetch</div>
          <div class="mt-3 grid grid-cols-[110px_1fr] gap-x-4 gap-y-1 text-zinc-300">
            <span class="text-zinc-500">user</span><span>Jorge Barnaby (yorch)</span>
            <span class="text-zinc-500">role</span><span>Principal SWE @ SentinelOne</span>
            <span class="text-zinc-500">location</span><span>Miami, FL</span>
            <span class="text-zinc-500">projects</span><span>{visible.length} curated / {totalAll} total · {hiddenCount} hidden</span>
            <span class="text-zinc-500">stars</span><span>{totalStars} ★</span>
            <span class="text-zinc-500">shell</span><span>zsh · <code class="rounded bg-zinc-900 px-1">⌘K</code> palette</span>
          </div>
          <div class="mt-4 flex flex-wrap gap-2 text-xs">
            <a href="#projects" class="rounded-full bg-emerald-500 px-3 py-1.5 font-medium text-black hover:bg-emerald-400">ls projects/ ↓</a>
            <a href="https://github.com/yorch" target="_blank" class="rounded-full border border-zinc-700 px-3 py-1.5 text-zinc-300 hover:border-zinc-600 hover:text-white">github.com/yorch →</a>
            <span class="hidden items-center gap-2 rounded-full border border-zinc-800 px-3 py-1.5 text-zinc-500 md:inline-flex">curated via curation.json</span>
          </div>
        </div>
        <div class="rounded-lg bg-zinc-900/30 p-3">
          <div class="font-mono text-[11px] tracking-widest text-zinc-500">yorch — ascii</div>
          <pre class="mt-2 text-[10px] leading-3 text-emerald-400">  _  _  ___  ___  ___  _  _
 | |/\| |/ _ \| _ \/ __|| || |
 |  \/ | (_) |   / (__ | __ |
 |_/\___|\___/|_|\\___||_||_|</pre>
          <div class="mt-3 font-mono text-xs text-zinc-400">Try <code class="rounded bg-black px-1">⌘K</code> → <code class="rounded bg-black px-1">filter go</code>, <code class="rounded bg-black px-1">goto pi-statusbar</code> — then <code class="rounded bg-black px-1">/</code> to focus filter</div>
          <div class="mt-2 font-mono text-[11px] text-zinc-500">Press <code class="rounded bg-zinc-800 px-1">/</code> to focus filter · <code class="rounded bg-zinc-800 px-1">Esc</code> to close palette</div>
        </div>
      </div>
      <div class="mt-4 flex items-center gap-3 border-t border-zinc-800 pt-3 font-mono text-xs">
        <span class="text-emerald-400">$</span><span class="text-zinc-300">ls projects/ | head — {featured.length} featured</span>
        <span class="ml-auto hidden text-zinc-600 md:inline">tiles match terminal — hover for emerald</span>
      </div>
    </div>
  </section>

  <!-- FILTERS + GRID — terminal tint, tiles match -->
  <section id="projects" class="mx-auto max-w-[1120px] px-6 pb-16">
    <div class="flex flex-col gap-4 border-t border-zinc-800 pt-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="font-mono text-sm tracking-widest text-emerald-400">~/open-source$ ls</h2>
        <p class="mt-1 font-mono text-xs text-zinc-500">{visible.length} shown of {totalAll} · curated via <a href="https://github.com/yorch/yorch.github.io/blob/master/src/data/curation.json" class="underline decoration-zinc-700 hover:text-zinc-300">curation.json</a> · <code class="rounded bg-zinc-900 px-1">⌘K</code> to jump</p>
      </div>
      <a href="https://github.com/yorch?tab=repositories" target="_blank" class="font-mono text-xs text-zinc-500 hover:text-zinc-300">→ github.com/yorch</a>
    </div>

    <div class="mt-6 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-1 gap-3">
        <label class="relative flex-1 max-w-[420px]" aria-label="Filter projects">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 font-mono text-xs text-emerald-400" aria-hidden="true">$</span>
          <input id="q" aria-label="Filter projects" placeholder="filter … e.g. astro, pino, go" class="w-full rounded border border-zinc-800 bg-black px-7 py-2.5 font-mono text-sm placeholder:text-zinc-600 focus:border-emerald-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500" />
        </label>
        <select id="lang" aria-label="Filter by language" class="rounded border border-zinc-800 bg-black px-3 py-2.5 font-mono text-xs text-zinc-300 focus:border-emerald-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
          <option value="">all lang</option>
          {languages.map((l) => <option value={l}>{l}</option>)}
        </select>
      </div>
      <div class="flex gap-2 font-mono text-xs" role="group" aria-label="Sort projects">
        <button data-sort="stars" aria-pressed="true" type="button" class="sort-btn active rounded bg-emerald-500 px-3 py-2 font-medium text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">★ stars</button>
        <button data-sort="updated" aria-pressed="false" type="button" class="sort-btn rounded border border-zinc-700 px-3 py-2 text-zinc-400 hover:border-zinc-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">recent</button>
      </div>
    </div>

    <div id="grid" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {sorted.map((p) => (
        <div class="proj" data-name={p.name.toLowerCase()} data-desc={(p.description ?? "").toLowerCase()} data-lang={p.language ?? ""} data-stars={p.stars} data-updated={p.updated}>
          <ProjectCard {...p} />
        </div>
      ))}
    </div>
    <div id="empty" class="hidden mt-10 text-center font-mono text-sm text-zinc-500" role="status" aria-live="polite">no match — try <code class="rounded bg-zinc-900 px-1">clear</code> or <code class="rounded bg-zinc-900 px-1">⌘K</code> → clear filter</div>
  </section>

  <!-- palette overlay -->
  <div id="palette" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Command palette">
    <div id="backdrop" class="absolute inset-0 bg-black/60 backdrop-blur"></div>
    <div class="relative mx-auto mt-[20vh] w-[min(640px,92vw)] rounded-xl border border-zinc-800 bg-zinc-900 shadow-2xl">
      <div class="flex items-center gap-3 border-b border-zinc-800 px-4 py-3">
        <span class="font-mono text-sm text-emerald-400" aria-hidden="true">$</span>
        <input id="palette-input" aria-label="Command palette" class="flex-1 bg-transparent font-mono text-sm outline-none placeholder:text-zinc-600" placeholder="filter typescript, goto pi-statusbar, clear" autocomplete="off" />
        <span class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-[10px] text-zinc-400">ESC</span>
      </div>
      <div id="palette-list" class="max-h-[50vh] overflow-auto p-2 font-mono text-sm"></div>
      <div class="border-t border-zinc-800 px-3 py-2 font-mono text-[11px] text-zinc-500">Tip: <code class="rounded bg-zinc-800 px-1">filter go</code> · <code class="rounded bg-zinc-800 px-1">goto &lt;name&gt;</code> · <code class="rounded bg-zinc-800 px-1">clear</code></div>
    </div>
  </div>

  <script is:inline define:vars={{ visible }}>
    const q = document.getElementById('q');
    const lang = document.getElementById('lang');
    const grid = document.getElementById('grid');
    const empty = document.getElementById('empty');
    const btns = document.querySelectorAll('.sort-btn');
    let sort = 'stars';
    function apply() {
      const term = q.value.toLowerCase().trim();
      const lv = lang.value;
      let vis = [];
      for (const el of grid.children) {
        const hit = (!term || el.dataset.name.includes(term) || el.dataset.desc.includes(term)) && (!lv || el.dataset.lang === lv);
        el.style.display = hit ? '' : 'none';
        if (hit) vis.push(el);
      }
      empty.style.display = vis.length ? 'none' : '';
      const sorted = [...vis].sort((a, b) => sort === 'stars' ? Number(b.dataset.stars) - Number(a.dataset.stars) : new Date(b.dataset.updated) - new Date(a.dataset.updated));
      for (const el of sorted) grid.appendChild(el);
    }
    function setSort(s) {
      sort = s;
      btns.forEach((b) => {
        const active = b.dataset.sort === s;
        b.className = active ? 'sort-btn active rounded bg-emerald-500 px-3 py-2 font-medium text-black' : 'sort-btn rounded border border-zinc-700 px-3 py-2 text-zinc-400 hover:border-zinc-600';
        b.setAttribute('aria-pressed', String(active));
      });
      apply();
    }
    q.addEventListener('input', apply);
    lang.addEventListener('change', apply);
    btns.forEach((b) => { b.addEventListener('click', () => setSort(b.dataset.sort)); });

    // palette
    const palette = document.getElementById('palette');
    const backdrop = document.getElementById('backdrop');
    const input = document.getElementById('palette-input');
    const list = document.getElementById('palette-list');
    const openNav = document.getElementById('open-palette-nav');
    function renderList(q) {
      const term = (q || '').toLowerCase().trim();
      const cmds = [
        { id: 'filter:ts', label: 'filter: typescript', desc: 'Show TypeScript', run: () => { q.value = ''; lang.value = 'TypeScript'; apply(); close(); } },
        { id: 'filter:go', label: 'filter: go', desc: 'Show Go', run: () => { q.value = ''; lang.value = 'Go'; apply(); close(); } },
        { id: 'clear', label: 'clear filter', desc: 'Show all', run: () => { q.value = ''; lang.value = ''; apply(); close(); } },
      ];
      const projs = visible.filter((p) => !term || p.name.toLowerCase().includes(term) || (p.description || '').toLowerCase().includes(term) || term.startsWith('filter') || term.startsWith('goto')).slice(0, 8).map((p) => ({ id: `goto:${p.name}`, label: `goto ${p.name}`, desc: p.description || '', run: () => { q.value = p.name; lang.value=''; apply(); const el = [...grid.children].find((e) => e.dataset.name === p.name.toLowerCase()); if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); el.querySelector('div').classList.add('ring','ring-emerald-500'); setTimeout(() => el.querySelector('div').classList.remove('ring','ring-emerald-500'), 1200); } close(); } }));
      const pool = [...cmds, ...projs];
      const filtered = pool.filter((c) => !term || c.label.toLowerCase().includes(term) || term.split(' ').some((w) => c.label.includes(w)));
      list.innerHTML = filtered.map((c) => `<button data-id="${c.id}" class="flex w-full items-center justify-between rounded px-3 py-2 text-left hover:bg-zinc-800"><span>${c.label}</span><span class="ml-4 max-w-[28ch] truncate text-xs text-zinc-500">${c.desc || ''}</span></button>`).join('') || `<div class="px-3 py-6 text-center text-zinc-500">no match for "${q}"</div>`;
      list.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { const c = [...cmds, ...projs].find((x) => x.id === b.dataset.id); if (c) c.run(); }));
    }
    let lastFocus = null;
    function open() { lastFocus = document.activeElement; palette.classList.remove('hidden'); document.getElementById('projects').inert = true; document.querySelector('header').inert = true; input.value = ''; renderList(''); input.focus(); document.body.style.overflow = 'hidden'; }
    function close() { palette.classList.add('hidden'); document.getElementById('projects').inert = false; document.querySelector('header').inert = false; document.body.style.overflow = ''; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
    if (openNav) openNav.addEventListener('click', open);
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); palette.classList.contains('hidden') ? open() : close(); }
      if (e.key === 'Escape' && !palette.classList.contains('hidden')) close();
      if (e.key === '/' && document.activeElement === document.body && palette.classList.contains('hidden')) { e.preventDefault(); document.getElementById('q').focus(); }
    });
    input.addEventListener('input', () => renderList(input.value));
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const first = list.querySelector('button'); if (first) first.click(); } });
    renderList('');
  </script>
</Base>
