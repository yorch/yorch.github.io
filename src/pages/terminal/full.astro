---
import projectsRaw from "../../data/projects.json";
import curation from "../../data/curation.json";

const hiddenSet = new Set((curation.hidden ?? []) as string[]);
const visibleRaw = Array.isArray((curation as any).visible) && (curation as any).visible.length > 0
  ? projectsRaw.filter((p) => ((curation as any).visible as string[]).includes(p.name))
  : projectsRaw.filter((p) => !hiddenSet.has(p.name));
const featuredNames = (curation.featured ?? []) as string[];
const featured = featuredNames.map((n) => visibleRaw.find((p) => p.name === n)).filter(Boolean) as typeof visibleRaw;
const featuredSet = new Set(featured.map((p) => p.name));
const rest = visibleRaw.filter((p) => !featuredSet.has(p.name)).sort((a,b)=> b.stars - a.stars || new Date(b.updated).getTime() - new Date(a.updated).getTime());
const visible = [...featured, ...rest];
const totalAll = projectsRaw.length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>yorch@web:~$ — full shell</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      html,body{margin:0;background:#0a0a0b;color:#e4e4e7;font-family:"JetBrains Mono", ui-monospace, monospace}
      a{color:#34d399} a:hover{color:#6ee7b7}
      ::selection{background:#fff;color:#000}
    </style>
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-[900px] px-4 py-6">
      <div class="mb-3 flex items-center justify-between text-xs text-zinc-500">
        <a href="/terminal" class="underline decoration-zinc-700 hover:text-zinc-300">← exploration</a>
        <span>full shell — try: <code class="bg-zinc-900 px-1">help</code> <code class="bg-zinc-900 px-1">ls</code> <code class="bg-zinc-900 px-1">cat &lt;name&gt;</code></span>
      </div>

      <div id="term" class="rounded-xl border border-zinc-800 bg-black p-4 md:p-6 font-mono text-[13px] leading-5 shadow-2xl">
        <div class="mb-3 flex items-center gap-2 border-b border-zinc-800 pb-3 text-xs">
          <span class="h-3 w-3 rounded-full bg-red-500"></span><span class="h-3 w-3 rounded-full bg-yellow-500"></span><span class="h-3 w-3 rounded-full bg-green-500"></span>
          <span class="ml-2 text-zinc-500">yorch@web:~/open-source — zsh — 80×24</span>
        </div>
        <div id="out" class="whitespace-pre-wrap"></div>
        <div class="mt-2 flex items-center gap-2">
          <span class="shrink-0 text-emerald-400">yorch@web:~/open-source$</span>
          <input id="in" class="flex-1 bg-transparent outline-none placeholder:text-zinc-600" placeholder="type help and press enter" autocomplete="off" spellcheck="false" />
          <span class="h-4 w-2 animate-pulse bg-zinc-200"></span>
        </div>
      </div>

      <div class="mt-4 text-xs text-zinc-500">
        <span id="count">{visible.length} shown / {totalAll} total</span> · <a href="/terminal/hybrid" class="underline">hybrid</a> · <a href="/" class="underline">minimal</a>
      </div>
    </div>

    <script is:inline define:vars={{ visible }}>
      const out = document.getElementById('out');
      const inp = document.getElementById('in');
      const projects = visible;

      const help = `available commands:
  help                 show this
  ls                   list projects (featured ★ first)
  ls -l                long list with lang + stars
  cat <name>           show project (try: cat pi-statusbar)
  filter <lang>        e.g. filter typescript
  search <term>        e.g. search astro
  clear                clear screen
  theme [green|amber|zinc]`;

      function print(t=""){ out.textContent += t + "\n"; out.scrollTop = out.scrollHeight; }
      function prompt(cmd){ print(`\x1b yorch@web:~/open-source$ ${cmd}`.replace('\x1b','')); }

      function ls(long=false){
        const list = long ? projects.map(p=> `${String(p.stars).padStart(2)}  ${(p.language||'-').padEnd(10)}  ${p.name.padEnd(32)}  ${p.description||''}`) : projects.map(p=> p.name);
        print(list.join(long ? "\n" : "  "));
      }
      function cat(name){
        const p = projects.find(x=> x.name.toLowerCase()===name.toLowerCase());
        if(!p){ print(`cat: ${name}: No such project`); return; }
        print(`${p.name}  ${p.language||''}  ★${p.stars}\n${p.description||'(no description)'}\n${p.url}\n${p.homepage? `website: ${p.homepage}`:''}\nupdated: ${new Date(p.updated).toLocaleDateString()}`);
      }

      print(`yorch.github.io — Jorge Barnaby
Principal Software Engineer @ SentinelOne · ${projects.length} curated projects
Type 'help' to start.\n`);
      print(help + "\n");

      inp.addEventListener('keydown', (e)=>{
        if(e.key!=='Enter') return;
        const cmd = inp.value.trim();
        prompt(cmd);
        const [c, ...rest] = cmd.split(/\s+/);
        const arg = rest.join(' ');
        if(c==='help') print(help);
        else if(c==='ls' && arg==='-l') ls(true);
        else if(c==='ls' || c==='') ls(false);
        else if(c==='cat') cat(arg);
        else if(c==='filter') { const lang=arg.toLowerCase(); const f=projects.filter(p=> (p.language||'').toLowerCase()===lang); print(f.length? f.map(p=>p.name).join('  ') : `no projects with lang ${lang}`); }
        else if(c==='search'){ const t=arg.toLowerCase(); const f=projects.filter(p=> p.name.toLowerCase().includes(t) || (p.description||'').toLowerCase().includes(t)); print(f.length? f.map(p=>p.name).join('  ') : `no match for ${arg}`); }
        else if(c==='clear') out.textContent='';
        else if(c==='theme'){ document.body.style.background = arg==='amber' ? '#0a0a0b' : arg==='green' ? '#01140a' : '#0a0a0b'; print(`theme ${arg||'zinc'}`); }
        else if(cmd) print(`${c}: command not found — try help`);
        inp.value=''; window.scrollTo(0, document.body.scrollHeight);
      });
      inp.focus();
    </script>
  </body>
</html>
