---
interface Props {
  name: string;
  description: string | null;
  stars: number;
  forks: number;
  language: string | null;
  topics: string[];
  updated: string;
  url: string;
  homepage: string | null;
}
const { name, description, stars, forks, language, topics, updated, url, homepage } = Astro.props;

const langColors: Record<string, string> = {
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  Python: "#3572A5",
  Go: "#00ADD8",
  Shell: "#89e051",
  Astro: "#ff5a03",
  Ruby: "#701516",
  Java: "#b07219",
};

const color = language ? (langColors[language] ?? "#52525b") : null;
const updatedLabel = new Date(updated).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 hover:border-zinc-700 hover:bg-zinc-900 transition text-left h-full"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="font-semibold text-[15px] leading-tight text-zinc-100 group-hover:text-white line-clamp-1">{name}</h3>
    <span class="shrink-0 inline-flex items-center gap-1 text-xs text-zinc-400 bg-zinc-800/80 rounded-full px-2 py-0.5">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.192L.818 6.365a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
      {stars}
    </span>
  </div>

  <p class="text-[13.5px] leading-5 text-zinc-400 line-clamp-3 min-h-[60px] mb-4">
    {description ?? "No description provided."}
  </p>

  {topics.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-4">
      {topics.slice(0, 3).map((t) => (
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400 border border-zinc-700/50">{t}</span>
      ))}
    </div>
  )}

  <div class="mt-auto flex items-center justify-between text-xs text-zinc-500">
    <span class="flex items-center gap-2">
      {language && (
        <>
          <span class="inline-block w-2.5 h-2.5 rounded-full" style={`background:${color}`}></span>
          <span class="text-zinc-400">{language}</span>
          <span class="opacity-30">·</span>
        </>
      )}
      <span>Updated {updatedLabel}</span>
    </span>
    <span class="opacity-60 group-hover:opacity-100 transition">→</span>
  </div>
</a>
